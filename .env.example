# ────────────────────────────────────────────────────────────────
# Telegram Crawler — settings
# Copy this file to .env and fill in your values:   cp .env.example .env
# Used by both `python main.py` and `docker compose`.
# ────────────────────────────────────────────────────────────────

# ── Telegram (required) ─────────────────────────────────────────
# Get both at https://my.telegram.org/apps
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef
# Name of the login session file (saved in DATA_DIR as <name>.session)
SESSION_NAME=default_session

# ── Folders ─────────────────────────────────────────────────────
# Where downloaded media is saved. Any folder, e.g. an external disk:
#   DOWNLOADS_DIR=/Volumes/Backup/telegram
# Relative paths start from the project folder.
DOWNLOADS_DIR=./downloads
# Where the app keeps its own files: Telegram session, download_state.json
# (remembers what was downloaded), channels.txt (channels you added), thumbnails.
# Leave empty to use the project folder (the old layout; in docker empty means ./data).
DATA_DIR=./data

# ── Download defaults (can be changed per run on the Download page) ──
# Files downloaded at the same time (1-20)
BATCH_SIZE=5
# Messages scanned per channel (0 = all)
MAX_MESSAGES=1000
# Extra channels you are not a member of, comma separated.
# Prefer adding them on the Download page instead (saved to channels.txt).
#   EXTRA_CHANNELS=@somechannel,https://t.me/another,-1001234567890
EXTRA_CHANNELS=

# ── Web app ─────────────────────────────────────────────────────
# Address and port of the web app (http://VIEWER_HOST:VIEWER_PORT).
# In docker the app always listens on 0.0.0.0:5000 inside the container;
# VIEWER_PORT is then the port on your computer.
VIEWER_HOST=127.0.0.1
VIEWER_PORT=5000
# Docker only: who can open the page. 127.0.0.1 = this computer only,
# 0.0.0.0 = every device on your network (then turn on the login below).
PUBLISH_IP=127.0.0.1
# Login for the web page. Leave both empty to turn the login off.
VIEWER_USER=
VIEWER_PASS=

# ── Viewer ──────────────────────────────────────────────────────
# Default tiles per page on a channel page (20, 50 and 100 are always offered)
VIEWER_PAGE_SIZE=20
# Minimum tile width in pixels (smaller = more tiles per row)
VIEWER_TILE_SIZE=480
# ffmpeg program used for video thumbnails (docker image already includes it)
FFMPEG_BIN=ffmpeg
